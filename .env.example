# ─────────────────────────────────────────────────────────────
#  tamilvazhi-web — environment
#  Local: copy to .env.local.  Dokploy: Environment + Build Arguments tabs.
# ─────────────────────────────────────────────────────────────

# API base URL as the BROWSER sees it. Baked in at build time, so it must also
# be set as a Build Argument in Dokploy — not only as a runtime variable.
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Optional: API URL for server-to-server calls from Next.js. Point this at the
# Dokploy internal service hostname so page rendering skips the public internet
# and TLS handshake. Falls back to NEXT_PUBLIC_API_URL when unset.
# INTERNAL_API_URL="http://tamilvazhi-api:4000"

# Shown in the header, page titles and the login screen.
NEXT_PUBLIC_SITE_NAME="Tamilvazhi"
